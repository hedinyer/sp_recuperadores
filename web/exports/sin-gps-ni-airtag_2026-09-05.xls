 <Worksheet ss:Name="Resumen">
  <Table ss:DefaultColumnWidth="80">
   <Column ss:Width="200"/>
   <Column ss:Width="520"/>
   <Row ss:Height="28"><Cell ss:StyleID="titulo"><Data ss:Type="String">Sin GPS ni AirTag — posibles robadas</Data></Cell></Row>
   <Row/>
   <Row><Cell ss:StyleID="bold"><Data ss:Type="String">Informe</Data></Cell><Cell ss:StyleID="celda"><Data ss:Type="String">Sin GPS ni AirTag</Data></Cell></Row>
<Row><Cell ss:StyleID="bold"><Data ss:Type="String">Generado</Data></Cell><Cell ss:StyleID="celda"><Data ss:Type="String">5/9/2026, 10:08:25 a. m.</Data></Cell></Row>
<Row><Cell ss:StyleID="bold"><Data ss:Type="String">Criterio</Data></Cell><Cell ss:StyleID="celda"><Data ss:Type="String">AirTag muerto (sin / no found / &gt;3 días) Y GPS muerto (sin / no activo / &gt;3 días)</Data></Cell></Row>
<Row><Cell ss:StyleID="bold"><Data ss:Type="String">Contratos activos</Data></Cell><Cell ss:StyleID="celda"><Data ss:Type="String">959</Data></Cell></Row>
<Row><Cell ss:StyleID="bold"><Data ss:Type="String">Motos en la lista</Data></Cell><Cell ss:StyleID="celda"><Data ss:Type="String">313</Data></Cell></Row>
<Row><Cell ss:StyleID="bold"><Data ss:Type="String">Sin AirTag</Data></Cell><Cell ss:StyleID="celda"><Data ss:Type="String">250</Data></Cell></Row>
<Row><Cell ss:StyleID="bold"><Data ss:Type="String">AirTag &gt;3 días sin marcar</Data></Cell><Cell ss:StyleID="celda"><Data ss:Type="String">9</Data></Cell></Row>
<Row><Cell ss:StyleID="bold"><Data ss:Type="String">AirTag no encontrado</Data></Cell><Cell ss:StyleID="celda"><Data ss:Type="String">54</Data></Cell></Row>
<Row><Cell ss:StyleID="bold"><Data ss:Type="String">Sin dispositivo GPS</Data></Cell><Cell ss:StyleID="celda"><Data ss:Type="String">258</Data></Cell></Row>
<Row><Cell ss:StyleID="bold"><Data ss:Type="String">GPS &gt;3 días sin señal</Data></Cell><Cell ss:StyleID="celda"><Data ss:Type="String">42</Data></Cell></Row>
<Row><Cell ss:StyleID="bold"><Data ss:Type="String">GPS no activo</Data></Cell><Cell ss:StyleID="celda"><Data ss:Type="String">13</Data></Cell></Row>
   <Row/>
   <Row><Cell ss:StyleID="celda"><Data ss:Type="String">Orden de la hoja "Lista": 1) sin AirTag y sin GPS, 2) resto por más días sin señal, 3) placa.</Data></Cell></Row>
  </Table>
